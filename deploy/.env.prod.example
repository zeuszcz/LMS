# Copy to .env.prod on the VPS, then `docker compose --env-file .env.prod -f docker-compose.prod.yml up -d`

# --- Database ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=replace_me_long_random
POSTGRES_DB=lms

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_me_with_48_byte_random_string

# --- Bootstrap superuser (created on first migration if absent) ---
BOOTSTRAP_SUPERUSER_EMAIL=admin@yescenter.ru
BOOTSTRAP_SUPERUSER_PASSWORD=replace_me_strong

# --- S3 / MinIO ---
S3_ACCESS_KEY=lms-prod-key
S3_SECRET_KEY=replace_me_long_random
S3_BUCKET=lms-media
S3_REGION=ru-central1

# --- SMTP (SendGrid / Yandex / etc.) ---
# Default falls back to a local mailhog container — replace for real prod email.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=no-reply@yescenter.ru
SMTP_PASSWORD=replace_me
SMTP_FROM=no-reply@yescenter.ru

# --- LiveKit (reuses messenger-livekit on the same VPS) ---
LIVEKIT_URL=wss://livekit.innertalk.space
LIVEKIT_API_KEY=replace_with_messenger_livekit_api_key
LIVEKIT_API_SECRET=replace_with_messenger_livekit_api_secret

# --- Public URL (used in email links + CORS) ---
PUBLIC_BASE_URL=https://yes.innertalk.space
