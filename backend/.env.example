APP_NAME=YES LMS API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://lms:lms_dev_password@localhost:5432/lms

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Bootstrap superuser
BOOTSTRAP_SUPERUSER_EMAIL=admin@yescenter.ru
BOOTSTRAP_SUPERUSER_PASSWORD=change_me_immediately

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev
S3_BUCKET=lms-media
S3_REGION=ru-central1

# SMTP (dev: mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yescenter.local
